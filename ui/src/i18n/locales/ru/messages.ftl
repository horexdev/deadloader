## Sizes, labelled like Windows Explorer labels them

size-bytes =
    { $count ->
        [one] { $count } байт
        [few] { $count } байта
        [many] { $count } байт
       *[other] { $count } байта
    }
size-kb = { $value } КБ
size-mb = { $value } МБ
size-gb = { $value } ГБ
size-tb = { $value } ТБ
